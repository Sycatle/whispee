# Local development only. This password is worthless: it opens nothing but a throwaway Postgres
# listening on loopback.
DATABASE_URL=postgres://whispee:dev_only_not_a_secret@localhost:55432/whispee
SERVER_ADDR=127.0.0.1:8787

# The transparency log's public key, base64, 32 bytes — as printed by the server on first boot.
#
# Optional, and empty here on purpose. Set it and the client refuses any log head signed by a
# different key, which is the only check that works on a first contact with a server: everything
# else compares the server against its own past. It closes that hole in the **desktop binary**,
# whose interface is packaged inside a signed artefact. On the web the server ships this bundle,
# so it ships the pin with it — there it turns a silent substitution into one that breaks every
# client at once, which is worth having and is not a defence.
#
# A deployment generates this key on its first boot, so there is nothing to set until then, and
# an unset pin leaves behaviour exactly as it was.
VITE_LOG_PUBKEY=
