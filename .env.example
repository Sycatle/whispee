# Local development only. This password is worthless: it opens nothing but a throwaway Postgres
# listening on loopback.
DATABASE_URL=postgres://whispee:dev_only_not_a_secret@localhost:55432/whispee
SERVER_ADDR=127.0.0.1:8787

# The transparency log's public key, base64, 32 bytes — as printed by the server on first boot.
#
# Optional, and empty here on purpose. Set it and the client refuses any log head signed by a
# different key, which is the only check that works on a first contact with a server: everything
# else compares the server against its own past. It closes that hole in the **desktop binary**,
# whose interface is packaged inside a signed artefact. On the web the server ships this bundle,
# so it ships the pin with it — there it turns a silent substitution into one that breaks every
# client at once, which is worth having and is not a defence.
#
# A deployment generates this key on its first boot, so there is nothing to set until then, and
# an unset pin leaves behaviour exactly as it was.
VITE_LOG_PUBKEY=

# ---------------------------------------------------------------------------- calls
#
# All of these are optional, and empty here on purpose. Without them the server refuses to hand
# out a call token — 503, not 404 — and the client hides the call button. A deployment that runs
# no media server keeps a fully working messenger, exactly as one that talks to neither Apple nor
# Google does. Bring the two services up with `docker compose --profile calls up -d`.
#
# **Read `crates/server/src/call.rs` before turning this on.** A call leaks more than a message
# does: this server sees that somebody is joining a call and towards which group, and the media
# server sees who shares a room with whom, for how long. Neither can hear anything — the audio is
# encrypted under a key derived from the MLS epoch, which is never sent anywhere.
#
# The values the two compose services are configured with are named beside each variable below,
# because they are not guessable and are not interchangeable: a key that does not match
# `scripts/livekit.yaml` mints tokens the media server refuses, and a relay secret that does not
# match `docker-compose.yml` mints credentials the relay refuses. Neither refusal reaches the
# person who set them — the browser only reports that the call did not happen.
#
# The media server, as the delivery service reaches it. `MEDIA_URL` is handed to clients as-is.
# Locally: ws://127.0.0.1:7880, and the key pair from `scripts/livekit.yaml`.
MEDIA_URL=
MEDIA_API_KEY=
MEDIA_API_SECRET=

# The relay, for connections that find no direct path. Comma-separated; the secret is shared with
# the relay and with nothing else — it mints credentials that expire in hours. Locally:
# turn:127.0.0.1:3478, and the `--static-auth-secret` from `docker-compose.yml`.
RELAY_URLS=
RELAY_SECRET=

# The media server's origin, for the client's Content-Security-Policy. It is a *build-time*
# value: the policy is computed into index.html, so changing it means rebuilding the client. Set
# it to the same host as MEDIA_URL, or the signalling socket is blocked by the browser with no
# error the page can see.
VITE_MEDIA_URL=

# Ceiling on the bytes one account may keep on this server: its history vault plus the
# attachments it uploaded. 268435456 (256 MiB) when unset; `0` disables the ceiling entirely,
# which is the pre-quota behaviour and leaves the vault unbounded. Envelopes are not counted
# here — bounding them per account takes anonymous tokens, see
# docs/specs/2026-08-24-posting-allowance.md.
ACCOUNT_STORAGE_BYTES=
