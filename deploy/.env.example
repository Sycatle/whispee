# Copy to `deploy/.env` and fill in. That file is git-ignored and must stay that way: it holds
# the database password and, if calls are configured, two shared secrets.
#
#     cp .env.example .env && chmod 600 .env
#
# Every variable marked required is enforced by the compose file itself — an unset one stops the
# stack with a sentence naming it, rather than starting something that half works.

# ----------------------------------------------------------------------------- required

# The domain this deployment answers on, without a scheme. Caddy obtains the certificate for it,
# so its A/AAAA record must already point here before the first start — ACME verifies by
# connecting back, and a domain that does not resolve fails in a way no retry fixes.
WHISPEE_DOMAIN=whispee.example

# Where certificate expiry warnings go. Unset, nobody is told before a renewal has already
# failed.
WHISPEE_ACME_EMAIL=you@example.com

# The database password. Generate it, do not choose it:
#
#     openssl rand -base64 32
#
# It is read by exactly two containers on a private network and by nothing else, which is what
# makes a random string with no mnemonic value the right answer.
POSTGRES_PASSWORD=

# ----------------------------------------------------------------------------- optional

# The transparency log's public key, base64, 32 bytes — printed by the server on its first boot,
# so there is nothing to set until then and an unset value leaves behaviour exactly as it was.
#
# Set it and the client refuses any log head signed by a different key. That is the only check
# that works on a first contact with a server: everything else compares the server against its
# own past. It closes the hole in the **desktop binary**, whose interface is packaged in a signed
# artefact. On the web this deployment serves both the pin and the code it constrains, so there
# it turns a silent substitution into one that breaks every client at once — worth having, and
# not a defence.
#
# Build-time. Setting it means `docker compose build web`.
VITE_LOG_PUBKEY=

# Ceiling on the bytes one account may keep here: its history vault plus the attachments it
# uploaded. 256 MiB when unset; `0` removes the ceiling and leaves the vault unbounded.
# Envelopes are counted in neither case — bounding them per account takes anonymous tokens, see
# ../docs/specs/2026-08-24-posting-allowance.md.
ACCOUNT_STORAGE_BYTES=

RUST_LOG=server=info,tower_http=info

# ----------------------------------------------------------------------------- calls
#
# All empty, and a deployment that leaves them empty keeps a fully working messenger: the call
# route answers 503 — not 404 — and the client hides the button.
#
# **Read `crates/server/src/call.rs` before turning this on.** A call leaks more than a message
# does: this server sees that somebody is joining a call and towards which group, and the media
# server sees who shares a room with whom, for how long. Neither can hear anything.
#
# This compose file runs no media server. Bringing one up on a public host is its own piece of
# work — LiveKit terminates WebRTC and wants a port range, coturn wants the same — and it is not
# solved here. These variables are for a deployment that already has both.
MEDIA_URL=
MEDIA_API_KEY=
MEDIA_API_SECRET=
RELAY_URLS=
RELAY_SECRET=

# The media server's origin, for the client's Content-Security-Policy. Build-time, and it must
# match MEDIA_URL's host or the browser blocks the signalling socket with no error the page can
# see.
VITE_MEDIA_URL=
